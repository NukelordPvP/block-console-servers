# Block LG TV firmware and update-related domains to prevent automatic updates
lgtv.care.cdms.lg.com         # LG firmware check
lgtv.plg.lge.com              # LG TV communication services
su.lge.com                    # Software updates
update.lgappstv.com           # App/firmware updates
fota.lge.com                  # Firmware Over-The-Air (FOTA) updates
cdn.lgappstv.com              # Content delivery for apps/updates